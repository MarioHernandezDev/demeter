# Copia este archivo a .env y cambia los valores. .env no se sube a git.
# Todas las variables tienen un valor por defecto para la demo en local.

# Clave que el simulador (y cualquier sensor) manda en la cabecera X-Ingest-Key
# al enviar lecturas a POST /api/sensor-data.
DEMETER_INGEST_KEY=demo-ingest-key

# Base de datos (B1/B2). SQLite en local; MySQL, PostgreSQL o MariaDB en otro entorno.
DEMETER_DATABASE_URL=sqlite:///data/demeter.db

# Secreto para firmar los tokens JWT del login (A3). Pon uno largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMETER_JWT_SECRET=cambia-esto-en-produccion
